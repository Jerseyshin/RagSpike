{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragspike.local/schemas/evaluation-case.schema.json",
  "title": "中国大陆隐私与数据合规问答评测样本",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "question",
    "question_type",
    "risk_level",
    "answerable",
    "gold_answer",
    "required_claims",
    "forbidden_claims",
    "evidence",
    "reasoning_outline",
    "expected_behavior",
    "as_of_date",
    "tags",
    "split",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {
      "type": "string",
      "pattern": "^CN-PRIV-[0-9]{4}$"
    },
    "question": {"type": "string", "minLength": 5},
    "question_type": {
      "enum": [
        "single_document_fact",
        "exact_article",
        "condition_exception",
        "cross_document",
        "version_conflict",
        "knowledge_missing",
        "ambiguity_false_premise"
      ]
    },
    "risk_level": {"enum": ["low", "medium", "high"]},
    "answerable": {"type": "boolean"},
    "gold_answer": {"type": "string", "minLength": 1},
    "required_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "reasoning_outline": {
      "description": "可审核的法律判断步骤摘要，不记录模型隐藏思维过程。",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_behavior": {
      "enum": ["answer", "refuse", "clarify", "correct_premise"]
    },
    "as_of_date": {"type": "string", "format": "date"},
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "split": {"enum": ["unassigned", "train", "development", "blind_test"]},
    "review_status": {"enum": ["draft", "approved", "rejected"]},
    "review_note": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"answerable": {"const": true}}},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"expected_behavior": {"const": "refuse"}}},
      "then": {
        "properties": {
          "answerable": {"const": false},
          "evidence": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "article",
        "source_artifact",
        "source_sha256",
        "source_url",
        "quote"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "article": {"type": ["string", "null"]},
        "source_artifact": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_url": {"type": "string", "format": "uri"},
        "quote": {"type": "string", "minLength": 4}
      }
    }
  }
}
